# Copie para .env (não vai para o GitHub) e preencha.

# Primeiro administrador: criado no arranque do servidor se ainda não existir nenhum.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administração

# Porta da API (o Vite encaminha /api para aqui em desenvolvimento).
PORT=3001

# Opcional: caminho do ficheiro SQLite (por omissão server/data/bolsaria.db).
# DB_PATH=

# Opcional: URL público, usado nas ligações de recuperação de palavra-passe.
# PUBLIC_URL=https://bolsaria.exemplo

# Opcional: atrás de um proxy reverso (nginx, etc.), para obter o IP real do cliente.
# TRUST_PROXY=1
