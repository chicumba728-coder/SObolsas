{
  "name": "bolsaria",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
